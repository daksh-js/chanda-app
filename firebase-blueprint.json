{
  "entities": {
    "Donor": {
      "title": "Donor",
      "description": "Individual Akhada donor profile with contact details, address, photo URI, and lifetime cash donation summary.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Authenticated Firebase UID owning the workspace." },
        "donorCode": { "type": "string", "description": "Unique human-readable donor code (e.g., DONOR-0001)." },
        "fullName": { "type": "string", "description": "Donor full name." },
        "fatherName": { "type": "string", "description": "Donor father's name." },
        "mobileNumber": { "type": "string", "description": "Primary 10-digit mobile number." },
        "whatsappNumber": { "type": "string", "description": "WhatsApp contact number." },
        "alternateMobile": { "type": "string", "description": "Optional alternate mobile number." },
        "address": { "type": "string", "description": "Full residential address." },
        "village": { "type": "string", "description": "Village name." },
        "city": { "type": "string", "description": "City or town." },
        "district": { "type": "string", "description": "District name." },
        "state": { "type": "string", "description": "State name." },
        "pinCode": { "type": "string", "description": "Postal PIN code." },
        "occupation": { "type": "string", "description": "Optional donor occupation." },
        "birthday": { "type": "string", "description": "Optional donor birthday (YYYY-MM-DD or DD/MM/YYYY)." },
        "notes": { "type": "string", "description": "Personal notes about the donor." },
        "photoUri": { "type": "string", "description": "Optional donor photograph URI or data URI." },
        "addedByAdmin": { "type": "string", "description": "Name of the Admin who registered this donor." },
        "lifetimeDonation": { "type": "integer", "description": "Total lifetime CASH donations in INR." },
        "donationCount": { "type": "integer", "description": "Total number of valid donations made by this donor." },
        "isFavorite": { "type": "boolean", "description": "Whether the donor is marked as a favorite patron." },
        "consentGiven": { "type": "boolean", "description": "Whether consent was obtained for storing photo and contact info." },
        "createdBy": { "type": "string", "description": "UID of creator." },
        "updatedBy": { "type": "string", "description": "UID of last updater." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp (FieldValue.serverTimestamp())." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp (FieldValue.serverTimestamp())." }
      },
      "required": [
        "userId",
        "donorCode",
        "fullName",
        "fatherName",
        "mobileNumber",
        "whatsappNumber",
        "address",
        "village",
        "city",
        "district",
        "state",
        "pinCode",
        "addedByAdmin",
        "lifetimeDonation",
        "donationCount",
        "isFavorite",
        "consentGiven",
        "createdBy",
        "updatedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "Donation": {
      "title": "Donation",
      "description": "Cash-only donation entry linked to a donor and responsible Akhada administrator.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Authenticated Firebase UID." },
        "donorId": { "type": "string", "description": "Firestore document ID of the donor." },
        "donorCode": { "type": "string", "description": "Unique donor code (e.g., DONOR-0001)." },
        "donorName": { "type": "string", "description": "Donor full name." },
        "donorMobile": { "type": "string", "description": "Donor mobile number." },
        "amount": { "type": "integer", "description": "Cash donation amount in INR." },
        "amountInWords": { "type": "string", "description": "Donation amount written in words." },
        "donationDate": { "type": "string", "description": "ISO date string YYYY-MM-DD of the donation." },
        "purpose": { "type": "string", "description": "Purpose of the donation (e.g., General Chanda, Kushti Diet, Arena Sand)." },
        "paymentMethod": { "type": "string", "enum": ["CASH"], "description": "Strictly CASH only." },
        "receiptNumber": { "type": "string", "description": "Unique generated receipt number." },
        "receivedByAdmin": { "type": "string", "description": "Name of the Admin who collected the cash." },
        "notes": { "type": "string", "description": "Optional additional notes." },
        "status": { "type": "string", "enum": ["CONFIRMED", "CORRECTED", "REVERSED"], "description": "Audit status of the donation." },
        "correctionNote": { "type": "string", "description": "Audit explanation if corrected or reversed." },
        "createdBy": { "type": "string", "description": "UID of creator." },
        "updatedBy": { "type": "string", "description": "UID of last updater." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp (FieldValue.serverTimestamp())." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp (FieldValue.serverTimestamp())." }
      },
      "required": [
        "userId",
        "donorId",
        "donorCode",
        "donorName",
        "donorMobile",
        "amount",
        "amountInWords",
        "donationDate",
        "purpose",
        "paymentMethod",
        "receiptNumber",
        "receivedByAdmin",
        "status",
        "createdBy",
        "updatedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "Receipt": {
      "title": "Receipt",
      "description": "Immutable cash donation receipt record with QR verification payload.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Authenticated Firebase UID." },
        "receiptNumber": { "type": "string", "description": "Unique receipt identifier." },
        "donationId": { "type": "string", "description": "Associated donation document ID." },
        "donorId": { "type": "string", "description": "Associated donor document ID." },
        "donorCode": { "type": "string", "description": "Unique donor code." },
        "donorName": { "type": "string", "description": "Donor full name." },
        "donorMobile": { "type": "string", "description": "Donor mobile number." },
        "amount": { "type": "integer", "description": "Cash donation amount in INR." },
        "amountInWords": { "type": "string", "description": "Donation amount in words." },
        "donationDate": { "type": "string", "description": "Donation date string." },
        "purpose": { "type": "string", "description": "Donation purpose." },
        "paymentMethod": { "type": "string", "enum": ["CASH"], "description": "Strictly CASH only." },
        "receivedByAdmin": { "type": "string", "description": "Admin who received the cash." },
        "akhadaName": { "type": "string", "description": "Akhada organization name." },
        "akhadaAddress": { "type": "string", "description": "Akhada organization address." },
        "thankYouMessage": { "type": "string", "description": "Thank-you note printed on receipt." },
        "qrPayload": { "type": "string", "description": "Verification QR code payload string." },
        "createdBy": { "type": "string", "description": "UID of creator." },
        "updatedBy": { "type": "string", "description": "UID of updater." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp." }
      },
      "required": [
        "userId",
        "receiptNumber",
        "donationId",
        "donorId",
        "donorCode",
        "donorName",
        "donorMobile",
        "amount",
        "amountInWords",
        "donationDate",
        "paymentMethod",
        "receivedByAdmin",
        "akhadaName",
        "akhadaAddress",
        "qrPayload",
        "createdBy",
        "updatedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "AuthorizedDevice": {
      "title": "AuthorizedDevice",
      "description": "Authorized Akhada administrator device record (up to 6 devices).",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Authenticated Firebase UID." },
        "installationId": { "type": "string", "description": "Unique device installation ID." },
        "deviceName": { "type": "string", "description": "Device model and hardware identifier." },
        "adminName": { "type": "string", "description": "Assigned Akhada administrator name." },
        "role": { "type": "string", "enum": ["OWNER_ADMIN", "STAFF_ADMIN"], "description": "Admin role tier." },
        "status": { "type": "string", "enum": ["APPROVED", "PENDING", "REVOKED"], "description": "Device authorization status." },
        "canAddDonor": { "type": "boolean", "description": "Permission to add donors." },
        "canEditDonor": { "type": "boolean", "description": "Permission to edit donor profiles." },
        "canDeleteDonor": { "type": "boolean", "description": "Permission to delete donor profiles." },
        "canRecordDonation": { "type": "boolean", "description": "Permission to record cash donations." },
        "canViewReports": { "type": "boolean", "description": "Permission to view financial reports." },
        "canExportData": { "type": "boolean", "description": "Permission to export PDF/CSV/Excel reports." },
        "lastActiveAt": { "type": "string", "description": "Last active timestamp string." },
        "createdBy": { "type": "string", "description": "UID of creator." },
        "updatedBy": { "type": "string", "description": "UID of last updater." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp." }
      },
      "required": [
        "userId",
        "installationId",
        "deviceName",
        "adminName",
        "role",
        "status",
        "canAddDonor",
        "canEditDonor",
        "canDeleteDonor",
        "canRecordDonation",
        "canViewReports",
        "canExportData",
        "lastActiveAt",
        "createdBy",
        "updatedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Immutable audit log entry recording administrator actions and device events.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Authenticated Firebase UID." },
        "actionType": { "type": "string", "description": "Action type code (e.g., DONOR_ADDED, DONATION_RECORDED, DONATION_CORRECTED, DEVICE_APPROVED, DEVICE_REVOKED)." },
        "description": { "type": "string", "description": "Human-readable audit description." },
        "adminName": { "type": "string", "description": "Responsible administrator name." },
        "deviceId": { "type": "string", "description": "Installation ID of the device." },
        "entityType": { "type": "string", "description": "Target entity type (DONOR, DONATION, RECEIPT, DEVICE, SETTINGS)." },
        "entityId": { "type": "string", "description": "Target entity ID." },
        "createdBy": { "type": "string", "description": "UID of creator." },
        "updatedBy": { "type": "string", "description": "UID of creator." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp." }
      },
      "required": [
        "userId",
        "actionType",
        "description",
        "adminName",
        "deviceId",
        "entityType",
        "entityId",
        "createdBy",
        "updatedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "AppSettings": {
      "title": "AppSettings",
      "description": "Akhada organization settings, branding, vault details, and message templates.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Authenticated Firebase UID." },
        "akhadaName": { "type": "string", "description": "Akhada organization title." },
        "akhadaRegNumber": { "type": "string", "description": "Registration or trust corpus identifier." },
        "akhadaAddress": { "type": "string", "description": "Official Akhada address printed on receipts." },
        "ownerAdminName": { "type": "string", "description": "Primary Owner Admin full name." },
        "ownerAdminPhone": { "type": "string", "description": "Primary Owner Admin phone number." },
        "vaultAllocationId": { "type": "string", "description": "Vault corpus allocation code." },
        "activeSeason": { "type": "string", "description": "Active financial season label." },
        "language": { "type": "string", "enum": ["EN", "HI", "BILINGUAL"], "description": "UI language preference." },
        "darkMode": { "type": "boolean", "description": "Whether dark mode is active." },
        "maxAuthorizedDevices": { "type": "integer", "description": "Maximum allowed devices (1 to 6)." },
        "thankYouTemplateHi": { "type": "string", "description": "Hindi WhatsApp thank-you template." },
        "thankYouTemplateEn": { "type": "string", "description": "English WhatsApp thank-you template." },
        "reminderTemplateHi": { "type": "string", "description": "Hindi WhatsApp reminder template." },
        "reminderTemplateEn": { "type": "string", "description": "English WhatsApp reminder template." },
        "createdBy": { "type": "string", "description": "UID of creator." },
        "updatedBy": { "type": "string", "description": "UID of last updater." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp." }
      },
      "required": [
        "userId",
        "akhadaName",
        "akhadaRegNumber",
        "akhadaAddress",
        "ownerAdminName",
        "ownerAdminPhone",
        "vaultAllocationId",
        "activeSeason",
        "language",
        "darkMode",
        "maxAuthorizedDevices",
        "thankYouTemplateHi",
        "thankYouTemplateEn",
        "reminderTemplateHi",
        "reminderTemplateEn",
        "createdBy",
        "updatedBy",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/donors/{donorId}": {
      "schema": { "$ref": "#/entities/Donor" },
      "description": "Registered Akhada donors."
    },
    "/donations/{donationId}": {
      "schema": { "$ref": "#/entities/Donation" },
      "description": "Cash donation ledger entries."
    },
    "/receipts/{receiptId}": {
      "schema": { "$ref": "#/entities/Receipt" },
      "description": "Generated cash donation receipts."
    },
    "/authorized_devices/{deviceId}": {
      "schema": { "$ref": "#/entities/AuthorizedDevice" },
      "description": "Authorized Akhada administrator devices (maximum 6)."
    },
    "/activity_logs/{logId}": {
      "schema": { "$ref": "#/entities/ActivityLog" },
      "description": "Audit trail of all admin and device activities."
    },
    "/app_settings/{settingId}": {
      "schema": { "$ref": "#/entities/AppSettings" },
      "description": "Akhada organization configuration and WhatsApp templates."
    }
  }
}
